{
  "name": "rebrowser-playwright",
  "version": "1.64.101",
  "description": "A drop-in replacement for playwright patched with rebrowser-patches. It allows to pass modern automation detection tests.",
  "keywords": [
    "rebrowser",
    "rebrowser-patches",
    "automation",
    "bot",
    "bot-detection",
    "captcha",
    "scraping",
    "web-scraping",
    "playwright",
    "chrome",
    "headless",
    "automation"
  ],
  "contributors": [
    "Nick Webson <nwebson@rebrowser.net>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebrowser/rebrowser-patches"
  },
  "bugs": {
    "url": "https://github.com/rebrowser/rebrowser-patches/issues"
  },
  "homepage": "https://playwright.dev",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./lib/common": "./lib/common/index.js",
    "./lib/program": "./lib/program.js",
    "./lib/runner": "./lib/runner/index.js",
    "./lib/transform/babelBundle": "./lib/transform/babelBundle.js",
    "./lib/util": "./lib/util.js",
    "./types/test": {
      "types": "./types/test.d.ts"
    },
    "./types/testReporter": {
      "types": "./types/testReporter.d.ts"
    },
    "./test": {
      "types": "./test.d.ts",
      "import": "./test.mjs",
      "require": "./test.js",
      "default": "./test.js"
    }
  },
  "bin": {
    "playwright": "cli.js"
  },
  "author": {
    "name": "Microsoft Corporation"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "rebrowser-playwright-core": "1.64.101"
  }
}
